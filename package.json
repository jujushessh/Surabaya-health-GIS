{
  "name": "surabaya-health-gis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web-GIS sebaran dan aksesibilitas fasilitas kesehatan terhadap kepadatan penduduk Kota Surabaya",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:boundaries": "node scripts/fetch-boundaries.mjs",
    "data:facilities": "node scripts/fetch-facilities.mjs",
    "data:population": "node scripts/fetch-population.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:all": "npm run data:boundaries && npm run data:facilities && npm run data:population && npm run data:build"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}